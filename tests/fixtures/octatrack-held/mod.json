{
 "id": "held-probe", "version": "1",
 "license": "GPL-2.0-or-later",
 "title": "held probe", "category": "Test", "author": "irpina",
 "description": "A probe of core-ot 0.11's events: counts the held editor's turns (and takes them when a poked control says), the pattern data's copies and the MIDI tracks' notes, with their last arguments.",
 "device": "octatrack", "os": "1.40C",
 "sources": ["probe.c"],
 "subscribe": [
  {"event": "ev_edit_held", "fn": "hd_edit_held", "order": 50},
  {"event": "ev_copy", "fn": "hd_copy", "order": 50},
  {"event": "ev_midi_note_sent", "fn": "hd_note_sent", "order": 50},
  {"event": "ev_scene_knob", "fn": "hd_scene_knob", "order": 50},
  {"event": "ev_tempo_open", "fn": "hd_tempo_open", "order": 50},
  {"event": "ev_arp_knob", "fn": "hd_arp_knob", "order": 50},
  {"event": "ev_knob_draw", "fn": "hd_knob_draw", "order": 50},
  {"event": "ev_leds", "fn": "hd_leds", "order": 50},
  {"event": "ev_trig_box_draw", "fn": "hd_trig_box", "order": 50}
 ],
 "requires": ["core"],
 "resources": {"core": "0.25"}
}
