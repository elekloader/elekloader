{
 "id": "seq-probe", "version": "1",
 "license": "GPL-2.0-or-later",
 "title": "seq probe", "category": "Test", "author": "irpina",
 "description": "A probe of core-ot 0.10's and 0.12's events: counts each one and logs its last arguments.",
 "device": "octatrack", "os": "1.40C",
 "sources": ["probe.c"],
 "subscribe": [
  {"event": "ev_part_apply", "fn": "sq_part_apply", "order": 50},
  {"event": "ev_chain_add", "fn": "sq_chain_add", "order": 50},
  {"event": "ev_seq_reset", "fn": "sq_seq_reset", "order": 50},
  {"event": "ev_midi_panic", "fn": "sq_midi_panic", "order": 50},
  {"event": "ev_track_length", "fn": "sq_track_length", "order": 50},
  {"event": "ev_pattern_wrap", "fn": "sq_pattern_wrap", "order": 50}
 ],
 "requires": ["core"],
 "resources": {"core": "0.12"}
}
