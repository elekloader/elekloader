{
 "id": "edit-probe", "version": "1",
 "license": "GPL-2.0-or-later",
 "title": "edit probe", "category": "Test", "author": "irpina",
 "description": "A probe of core-ot 0.8's events: counts each one, logs its arguments, refuses a paste or an undo, keeps a voice, changes a track icon and a SETUP knob when a poked control says, and runs a poked program of stock calls from the UI tick.",
 "device": "octatrack", "os": "1.40C",
 "sources": ["probe.c"],
 "subscribe": [
  {"event": "ev_boot_early", "fn": "ed_boot_early", "order": 50},
  {"event": "ev_boot_done", "fn": "ed_boot_done", "order": 50},
  {"event": "ev_clip", "fn": "ed_clip", "order": 50},
  {"event": "ev_part_saving", "fn": "ed_part_saving", "order": 50},
  {"event": "ev_part_reload", "fn": "ed_part_reload", "order": 50},
  {"event": "ev_part_init", "fn": "ed_part_init", "order": 50},
  {"event": "ev_project_init", "fn": "ed_project_init", "order": 50},
  {"event": "ev_part_select", "fn": "ed_part_select", "order": 50},
  {"event": "ev_voice_reset", "fn": "ed_voice_reset", "order": 50},
  {"event": "ev_voice_kill", "fn": "ed_voice_kill", "order": 50},
  {"event": "ev_track_icon", "fn": "ed_track_icon", "order": 50},
  {"event": "ev_track_icon_draw", "fn": "ed_track_icon_draw", "order": 50},
  {"event": "ev_setup_dial", "fn": "ed_setup_dial", "order": 50},
  {"event": "ev_tick", "fn": "ed_tick", "order": 50}
 ],
 "requires": ["core"],
 "resources": {"core": "0.8"}
}
